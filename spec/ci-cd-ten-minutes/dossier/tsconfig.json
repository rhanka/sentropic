{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "noEmit": true,
    "types": ["node", "svelte", "vite/client"], "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts", "playwright.config.ts", "tests/**/*.ts"]
}
