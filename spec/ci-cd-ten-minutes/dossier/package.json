{
  "name": "sentropic-ci-performance-dossier",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit",
    "lint": "eslint src scripts tests vite.config.ts playwright.config.ts",
    "build": "vite build && node scripts/build-portable.mjs",
    "test": "node --test tests/path-calculation.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@sentropic/design-system-svelte": "0.34.69",
    "@sentropic/design-system-themes": "0.11.0",
    "@xyflow/svelte": "1.6.5",
    "svelte": "5.56.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "24.10.1",
    "@typescript-eslint/parser": "8.56.1",
    "eslint": "10.0.2",
    "eslint-plugin-svelte": "3.15.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
