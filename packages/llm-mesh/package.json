{
  "name": "@sentropic/llm-mesh",
  "version": "0.29.0",
  "description": "Provider-agnostic LLM access runtime SDK for Sentropic.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sentropic.git",
    "directory": "packages/llm-mesh"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./speech": {
      "types": "./dist/speech/index.d.ts",
      "import": "./dist/speech/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./facade": {
      "types": "./dist/service/facade.d.ts",
      "import": "./dist/service/facade.js"
    },
    "./enrollment": {
      "types": "./dist/enrollment/index.d.ts",
      "import": "./dist/enrollment/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./decision": {
      "types": "./dist/decision/index.d.ts",
      "import": "./dist/decision/index.js"
    },
    "./decision/host": {
      "types": "./dist/decision/host.d.ts",
      "import": "./dist/decision/host.js"
    },
    "./transport/jev": {
      "types": "./dist/transport/jev.d.ts",
      "import": "./dist/transport/jev.js"
    },
    "./transport/cloud-code": {
      "types": "./dist/transport/cloud-code-transport.d.ts",
      "import": "./dist/transport/cloud-code-transport.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
