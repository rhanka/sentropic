{
  "name": "@sentropic/chat-server",
  "version": "0.3.0",
  "description": "Configurable Hono chat wire server and in-memory adapter for Sentropic-compatible apps.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sentropic.git",
    "directory": "packages/chat-server"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests"
  },
  "dependencies": {
    "@sentropic/chat-core": "^0.1.2",
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "typescript": "5.4.5"
  }
}
