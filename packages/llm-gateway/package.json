{
  "name": "@sentropic/llm-gateway",
  "version": "0.19.0",
  "description": "Authenticated, pooled, metered LLM egress gateway for Sentropic (WP16 Layer B). Provider-compatible Anthropic/OpenAI wire over the @sentropic/llm-mesh account pool.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sentropic.git",
    "directory": "packages/llm-gateway"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/caller-auth/service-auth.d.ts",
      "import": "./dist/caller-auth/service-auth.js"
    },
    "./auth-hono": {
      "types": "./dist/caller-auth/auth-hono.d.ts",
      "import": "./dist/caller-auth/auth-hono.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests"
  },
  "dependencies": {
    "@sentropic/llm-mesh": "^0.22.0",
    "hono": "^4.10.7"
  },
  "peerDependencies": {
    "@sentropic/mcp-auth": "^0.2.1",
    "@sentropic/auth-hono": "^0.15.0",
    "jose": "^5.10.0"
  },
  "peerDependenciesMeta": {
    "@sentropic/mcp-auth": { "optional": true },
    "@sentropic/auth-hono": { "optional": true },
    "jose": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "typescript": "5.4.5",
    "vitest": "4.1.0"
  }
}
