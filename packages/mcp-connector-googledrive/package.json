{
  "name": "@sentropic/mcp-connector-googledrive",
  "version": "0.0.0",
  "description": "Google Drive MCP connector adapter proof (BR-72), plus a Wave-2 EXPERIMENTAL write surface gated by @sentropic/mcp-platform's mutation-gate.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "import": "./dist/experimental.js"
    }
  },
  "typesVersions": {
    "*": {
      "experimental": [
        "./dist/experimental.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "typescript": "5.4.5",
    "vitest": "4.1.0"
  }
}
