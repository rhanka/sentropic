{
  "name": "@sentropic/artifacts",
  "version": "0.2.5",
  "description": "Generic configurable artifacts MCP and artifact service: StorageScope/Artifact/Binding/Release model, canonical manifests, object authorization, idempotent intents (spec-v8 §9).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sentropic.git",
    "directory": "packages/artifacts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#artifacts-frozen-commit": {
      "types": "./l0-freeze/commit-contract.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./codecs": {
      "types": "./dist/codecs.d.ts",
      "import": "./dist/codecs.js"
    },
    "./adapters/s3": {
      "types": "./dist/adapters/s3.d.ts",
      "import": "./dist/adapters/s3.js"
    },
    "./adapters/postgres": {
      "types": "./dist/adapters/postgres.d.ts",
      "import": "./dist/adapters/postgres.js"
    },
    "./adapters/postgres-commit": {
      "types": "./dist/adapters/postgres-commit.d.ts",
      "import": "./dist/adapters/postgres-commit.js"
    },
    "./adapters/postgres-activation": {
      "types": "./dist/adapters/postgres-activation.d.ts",
      "import": "./dist/adapters/postgres-activation.js"
    },
    "./adapters/postgres-activation/vectors": {
      "types": "./dist/adapters/postgres-activation-vectors.d.ts",
      "import": "./dist/adapters/postgres-activation-vectors.js"
    },
    "./sql/*": "./sql/*",
    "./migrations/*": "./migrations/*",
    "./server/ports": {
      "types": "./dist/server/ports.d.ts",
      "import": "./dist/server/ports.js"
    },
    "./server/service": {
      "types": "./dist/server/service.d.ts",
      "import": "./dist/server/service.js"
    },
    "./server/authorization": {
      "types": "./dist/server/authorization.d.ts",
      "import": "./dist/server/authorization.js"
    },
    "./server/commit-contract": {
      "types": "./dist/server/commit-contract.d.ts",
      "import": "./dist/server/commit-contract.js"
    },
    "./server/outcome-contract": {
      "types": "./dist/server/outcome-contract.d.ts",
      "import": "./dist/server/outcome-contract.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./server/bindings": {
      "types": "./dist/server/bindings.d.ts",
      "import": "./dist/server/bindings.js"
    },
    "./server/idempotency": {
      "types": "./dist/server/idempotency.d.ts",
      "import": "./dist/server/idempotency.js"
    },
    "./server/object-intents": {
      "types": "./dist/server/object-intents.d.ts",
      "import": "./dist/server/object-intents.js"
    },
    "./server/uploads": {
      "types": "./dist/server/uploads.d.ts",
      "import": "./dist/server/uploads.js"
    },
    "./server/publication": {
      "types": "./dist/server/publication.d.ts",
      "import": "./dist/server/publication.js"
    },
    "./server/access": {
      "types": "./dist/server/access.d.ts",
      "import": "./dist/server/access.js"
    },
    "./server/sources": {
      "types": "./dist/server/sources.d.ts",
      "import": "./dist/server/sources.js"
    },
    "./server/source-read": {
      "types": "./dist/server/source-read.d.ts",
      "import": "./dist/server/source-read.js"
    },
    "./server/management": {
      "types": "./dist/server/management.d.ts",
      "import": "./dist/server/management.js"
    },
    "./adapters/postgres-management": {
      "types": "./dist/adapters/postgres-management.d.ts",
      "import": "./dist/adapters/postgres-management.js"
    },
    "./server/fork": {
      "types": "./dist/server/fork.d.ts",
      "import": "./dist/server/fork.js"
    },
    "./server/lifecycle": {
      "types": "./dist/server/lifecycle.d.ts",
      "import": "./dist/server/lifecycle.js"
    },
    "./server/gc": {
      "types": "./dist/server/gc.d.ts",
      "import": "./dist/server/gc.js"
    },
    "./server/runtime": {
      "types": "./dist/server/runtime.d.ts",
      "import": "./dist/server/runtime.js"
    },
    "./server/reader-profile": {
      "types": "./dist/server/reader-profile.d.ts",
      "import": "./dist/server/reader-profile.js"
