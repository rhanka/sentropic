    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./mcp-core": {
      "types": "./dist/mcp-core.d.ts",
      "import": "./dist/mcp-core.js"
    },
    "./content/grants": {
      "types": "./dist/content/grants.d.ts",
      "import": "./dist/content/grants.js"
    },
    "./content/handler": {
      "types": "./dist/content/handler.d.ts",
      "import": "./dist/content/handler.js"
    },
    "./content/routing": {
      "types": "./dist/content/routing.d.ts",
      "import": "./dist/content/routing.js"
    },
    "./content/headers": {
      "types": "./dist/content/headers.d.ts",
      "import": "./dist/content/headers.js"
    },
    "./content/api-profile": {
      "types": "./dist/content/api-profile.d.ts",
      "import": "./dist/content/api-profile.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./parameters": {
      "types": "./dist/parameters.d.ts",
      "import": "./dist/parameters.js"
    },
    "./provider": {
      "types": "./dist/provider-definition.d.ts",
      "import": "./dist/provider-definition.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "l0-freeze",
    "src/contracts.ts",
    "migrations",
    "sql",
    "docs/migration-l6.md",
    "examples/radar-commit-setup.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "freeze-types": "tsc --noEmit --strict --skipLibCheck --target es2022 --module nodenext --moduleResolution nodenext --verbatimModuleSyntax l0-freeze/commit-contract.ts l0-freeze/failure-contract.ts l0-freeze/profile-contract.ts l0-freeze/command-identity-contract.ts",
    "test": "vitest run tests"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@sentropic/mcp-platform": ">=0.3.0 <0.5.0",
    "pg": "^8.12.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@sentropic/mcp-platform": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@types/node": "^22.10.10",
    "@types/pg": "^8.15.5",
    "pg": "^8.12.0",
    "typescript": "5.4.5",
    "vitest": "4.1.0"
  }
}
