{
  "name": "@sentropic/mcp-broker",
  "version": "0.2.0",
  "private": true,
  "description": "Plan-bound MCP provider broker with the frozen memory contract entry: McpProviderBroker dispatches against the immutable compiled registry plan with a verified host invocation context per call (MCP-L5 Lot 1). Memory contracts under ./memory. No in-memory identity manufacturing.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sentropic.git",
    "directory": "packages/mcp-broker"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./memory-reference": {
      "types": "./dist/memory-reference/index.d.ts",
      "import": "./dist/memory-reference/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "memory": [
        "./dist/memory/index.d.ts"
      ],
      "memory-reference": [
        "./dist/memory-reference/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests"
  },
  "dependencies": {
    "@sentropic/mcp-platform": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "typescript": "5.4.5",
    "vitest": "4.1.0"
  }
}
