{
  "name": "@sentropic/build-cli",
  "version": "0.1.0",
  "description": "The `stp app` processes of the Sentropic umbrella CLI: a deterministic, dependency-light scaffolding substrate (token substitution + scaffold manifest + generator core) that materialises a runnable chat-app whose backend mounts the published @sentropic/chat-server canonical routes. Behind an interface designed for later @sentropic/harness adoption (R5).",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sentropic.git",
    "directory": "packages/build-cli"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./templating": {
      "types": "./src/templating/index.ts",
      "import": "./src/templating/index.ts"
    },
    "./generator": {
      "types": "./src/generator/index.ts",
      "import": "./src/generator/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests"
  },
  "devDependencies": {
    "typescript": "5.4.5"
  }
}
