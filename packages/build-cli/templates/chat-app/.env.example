# Copy to .env and fill in. NEVER commit .env (see .gitignore).

# --- Ports (isolated; never the monorepo reserved 8787/5173/1080) ---
API_PORT={{api_port}}
UI_PORT={{ui_port}}
MAILDEV_UI_PORT={{maildev_port}}

# UI -> backend base URL (keep aligned with API_PORT).
VITE_API_BASE_URL=http://localhost:{{api_port}}

# --- Provider ---
# Default `stub` is a deterministic, offline reply (no key needed).
# Switch to a real @sentropic/llm-mesh provider by setting PROVIDER + its key.
PROVIDER={{provider}}

# Provider key slots (only the one matching PROVIDER is read).
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
