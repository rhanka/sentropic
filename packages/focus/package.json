{
  "name": "@sentropic/focus",
  "version": "0.4.1",
  "description": "Focused-session document runtime: read-only FocusSnapshot renderers plus the fail-closed FocusLiveSession owner-signature driver for Track-native decisions. Markdown is injected by the host and HTML is sanitized by the host.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sentropic.git",
    "directory": "packages/focus"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./track": {
      "types": "./dist/track/index.d.ts",
      "import": "./dist/track/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@sentropic/track": "^0.91.0",
    "hono": "^4.10.7"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "typescript": "5.4.5",
    "vitest": "4.1.0"
  }
}
