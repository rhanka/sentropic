{
  "name": "@sentropic/mcp-platform",
  "version": "0.3.0",
  "description": "Generic Sentropic/STP MCP provider platform contract: manifest/adapter/context schemas, session/consent/enrollment/secret records, elicitation, per-request authz, discovery/visibility and durable-call refs (SPEC_EVOL_APP_MCP_PROVIDER_PLATFORM). Broker-aware public surface — DRAFT, not frozen. In-memory mocks are a test harness only.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sentropic.git",
    "directory": "packages/mcp-platform"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "//exports": "TODO(BR-42l): add require/CJS condition (dual-emit) per llm-mesh; ESM-only for now.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "import": "./dist/experimental.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    },
    "./tool-configuration": {
      "types": "./dist/tool-configuration.d.ts",
      "import": "./dist/tool-configuration.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./registry/entry": {
      "types": "./dist/registry-entry.d.ts",
      "import": "./dist/registry-entry.js"
    }
  },
  "typesVersions": {
    "*": {
      "experimental": [
        "./dist/experimental.d.ts"
      ],
      "testing": [
        "./dist/testing.d.ts"
      ],
      "hono": [
        "./dist/hono.d.ts"
      ],
      "tool-configuration": [
        "./dist/tool-configuration.d.ts"
      ],
      "registry": [
        "./dist/registry.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0"
  },
  "peerDependencies": {
    "hono": "^4.10.7"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.9",
    "@types/node": "^22.10.10",
    "hono": "^4.10.7",
    "typescript": "5.4.5",
    "vitest": "4.1.0"
  }
}
