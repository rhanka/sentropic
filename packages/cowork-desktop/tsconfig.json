{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@sentropic/chat-ui": ["../chat-ui/src/index.ts"],
      "@sentropic/chat-ui/*": ["../chat-ui/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests/**", "dist/**", "bin/**"]
}
