{
  "name": "@sentropic/chat-runtime",
  "version": "0.1.0",
  "description": "Sentropic client session runtime, transport, stream assembly and local tools.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sentropic.git",
    "directory": "packages/chat-runtime"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./src/index.ts" },
    "./checkpoints": { "types": "./src/checkpoints/index.ts", "import": "./src/checkpoints/index.ts" },
    "./*": { "types": "./src/*.ts", "import": "./src/*.ts" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": { "access": "public", "provenance": true },
  "peerDependencies": { "svelte": "^5.0.0", "@sentropic/chat-ui": "^1.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests"
  }
}
