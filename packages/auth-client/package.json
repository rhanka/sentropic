{
  "name": "@sentropic/auth-client",
  "version": "0.1.0",
  "description": "Node-only OAuth2 client_credentials helper for Sentropic service-to-service auth: scoped, audience-bound, optionally DPoP-bound access tokens with in-memory caching.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/sentropic.git",
    "directory": "packages/auth-client"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests"
  },
  "peerDependencies": {
    "jose": "^5.10.0"
  }
}
