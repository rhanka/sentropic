{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetBucketPublicAccessBlock", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::artifacts"]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::artifacts/*"]
    }
  ]
}
