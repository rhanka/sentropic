{
  "name": "sentropic-vscode-extension",
  "type": "module",
  "displayName": "Sentropic",
  "description": "Sentropic VSCode plugin v1 runtime shell.",
  "version": "0.1.1",
  "publisher": "sentropic",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:sentropic.openPanel",
    "onView:sentropic.chatView"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "sentropic.openPanel",
        "title": "Sentropic: Open Chat Panel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sentropic",
          "title": "Sentropic",
          "icon": "sentropic-icon.svg"
        }
      ]
    },
    "views": {
      "sentropic": [
        {
          "id": "sentropic.chatView",
          "type": "webview",
          "name": "Sentropic"
        }
      ]
    },
    "configuration": {
      "title": "Sentropic",
      "properties": {
        "sentropic.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:8787/api/v1",
          "description": "Sentropic API base URL used by the VSCode extension runtime."
        },
        "sentropic.appBaseUrl": {
          "type": "string",
          "default": "http://localhost:5173",
          "description": "Sentropic app base URL used by open-link navigation in VSCode runtime."
        },
        "sentropic.wsBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional websocket base URL used by the VSCode extension runtime."
        },
        "sentropic.sessionToken": {
          "type": "string",
          "default": "",
          "description": "Session token used as Bearer auth for VSCode extension requests to /api/v1."
        }
      }
    }
  }
}
