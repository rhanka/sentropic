    { "id": "workspace-name", "authority": "A-W", "route": "PUT /workspaces/workspace-h0", "expectedPayload": { "name": "Research workspace" } },
    { "id": "comment-send", "authority": "A-COM", "route": "POST /comments", "expectedPayload": { "context_type": "initiative", "context_id": "initiative-h0", "content": "Second" } },
