      "expectedPayload": { "valueAxes": [{ "id": "value1", "name": "**Value** 1", "weight": 0.5, "levelDescriptions": [{ "level": 1, "description": "Keep level" }] }], "complexityAxes": [{ "id": "complexity1", "name": "Complexity 1", "weight": 0.5 }], "valueThresholds": [{ "level": 1, "points": 1 }], "complexityThresholds": [{ "level": 1, "points": 1 }] }
    },
    { "id": "new-folder-local", "authority": "A-FN", "route": null, "input": "Dossier Export", "expectedRequestsBeforeId": 0 },
