    },
    {
      "id": "score-siblings", "authority": "A-S", "route": "PUT /initiatives/initiative-h0",
      "before": { "valueScores": [{ "axisId": "value1", "rating": 2, "description": "Old" }, { "axisId": "value2", "rating": 3, "description": "Keep [1]" }] },
      "expectedPayload": { "valueScores": [{ "axisId": "value1", "rating": 2, "description": "Edited" }, { "axisId": "value2", "rating": 3, "description": "Keep [1]" }] }
    },
    {
