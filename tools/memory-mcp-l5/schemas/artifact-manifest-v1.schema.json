{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentropic.local/schemas/memory-mcp-l5/artifact-manifest-v1.schema.json",
  "title": "L5ArtifactManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "artifacts", "contractInventory"],
  "properties": {
    "manifestVersion": { "const": 1 },
    "artifacts": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "version", "sha256", "integrity", "archive"], "properties": {
      "name": { "type": "string", "minLength": 1, "maxLength": 256 },
      "version": { "type": "string", "minLength": 1, "maxLength": 64 },
      "sha256": { "$ref": "#/$defs/sha256" },
      "integrity": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$" },
      "archive": { "$ref": "#/$defs/relPath" }
    } } },
    "contractInventory": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {
      "path": { "$ref": "#/$defs/relPath" },
      "sha256": { "$ref": "#/$defs/sha256" }
    } } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relPath": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!.*\\.\\.)[^\\0]+$" }
  }
}
