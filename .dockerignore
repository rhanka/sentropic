node_modules/
**/node_modules/
.pnpm-store/

# Build outputs and caches
api/dist/
apps/artifact-content/dist/
api/.tsbuildinfo
packages/*/dist/
packages/cowork-desktop/build/
api/templates/.~lock*
ui/build/
ui/.svelte-kit/
ui/dist/
