data/
tmp/
.tmp/
artifacts/
.graphify/
graphify-out/
.security/sast-*
.security/sca-*
.security/iac-*
.security/container*

# Logs and large local archives
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tar
*.tar.gz
*-image.tar.zst
*-image.json
*.tgz
*.zip

# API production image determinism (fix/api-image-canonical-artifact):
# the canonical tag must equal the shipped bytes. Files no image stage
# needs (global-only changes, docs, tooling, non-consumed packages) must
# not enter the build context, or the production digest drifts without a
# tag change and publish refuses a tag collision.
Makefile
BRANCH.md
/*.md
/LICENSE
api/data.db
*.db
.github/
scripts/
!scripts/
scripts/*
!scripts/ci/
scripts/ci/*
!scripts/ci/locked-tools.mjs
!scripts/ci/tool-locks.json
tools/
spec/
plan/
docs/
rules/
track/
deploy/
# Exact source contracts read by the existing UI suite in BuildKit.
!Makefile
!.github/
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/ci.yml
!deploy/
deploy/*
!deploy/k8s/
deploy/k8s/*
!deploy/k8s/base/
deploy/k8s/base/*
!deploy/k8s/base/30-api.yaml
!deploy/k8s/base/40-ui.yaml
# e2e test sources stay out, except the toolbox build manifests and the
# fixtures imported by api unit tests (document-text-office-extension).
e2e/*
!e2e/package.json
!e2e/package-lock.json
!e2e/tests/
e2e/tests/*
!e2e/tests/fixtures/
