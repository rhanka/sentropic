AGENT_CA=/etc/execution-node/tls/ca.crt
AGENT_CERT=/etc/execution-node/tls/server.crt
AGENT_KEY=/etc/execution-node/tls/server.key
AGENT_PORT=8443
EXECUTION_NODE_PORTS_ENABLED=false
EXECUTION_NODE_PORTS_RUNSC_SHA256=
EXECUTION_NODE_PORT_FORWARD_MAX=2
AGENT_TICKET_PUBLIC_KEY=/etc/execution-node/keys/execution-ticket.ed25519.pub.pem
CUSTODY_PUBLIC_KEY=/etc/execution-node/keys/custody.ed25519.pub.pem
AGENT_OPERATOR_PUBLIC_KEYS=/etc/execution-node/keys/operator-ticket.ed25519.pub.pem
SANDBOX_ENV=preprod
PATH=/opt/gvisor/20261102:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# k8s appends RELEASE_DIR=/opt/execution-node/releases/<verified archive sha256>
